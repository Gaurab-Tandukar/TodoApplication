@{
    Layout = null;
    ViewData["Title"] = "Todo";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo</title>
    <style>
            :root {
              --ink: #1c1b1a;
              --paper: #faf8f5;
              --line: #ddd7cd;
              --accent: #3a5a4c;
              --accent-soft: #e4ede8;
              --danger: #a4443a;
              --p1: #a4443a;
              --p2: #b8863a;
              --p3: #6b7a70;
            }
            * { box-sizing: border-box; }
            body {
              margin: 0;
              background: var(--paper);
              color: var(--ink);
              font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
              min-height: 100vh;
            }
            header {
              padding: 2.5rem 1.5rem 1.5rem;
              text-align: center;
              border-bottom: 1px solid var(--line);
            }
            header h1 {
              margin: 0;
              font-size: 1.9rem;
              font-weight: 600;
              letter-spacing: 0.01em;
            }
            header p {
              margin: 0.4rem 0 0;
              color: #756f65;
              font-size: 0.9rem;
              font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            }
            main {
              max-width: 640px;
              margin: 0 auto;
              padding: 1.75rem 1.25rem 5rem;
            }
            form#task-form {
              display: grid;
              grid-template-columns: 1fr auto auto;
              gap: 0.6rem;
              margin-bottom: 0.5rem;
              font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            }
            form#task-form input[type=text] {
              grid-column: 1 / -1;
              padding: 0.75rem 0.9rem;
              border: 1px solid var(--line);
              border-radius: 8px;
              font-size: 1rem;
              background: white;
            }
            form#task-form select, form#task-form input[type=date] {
              padding: 0.6rem 0.7rem;
              border: 1px solid var(--line);
              border-radius: 8px;
              background: white;
              font-size: 0.85rem;
              color: #444;
            }
            form#task-form button {
              background: var(--accent);
              color: white;
              border: none;
              border-radius: 8px;
              padding: 0.6rem 1.2rem;
              font-size: 0.9rem;
              cursor: pointer;
              font-family: -apple-system, BlinkMacSystemFont, sans-serif;
            }
            form#task-form button:hover { background: #2d4a3e; }

            #status {
              font-family: -apple-system, BlinkMacSystemFont, sans-serif;
              font-size: 0.8rem;
              color: #8a5a3a;
              min-height: 1.2em;
              margin: 0.5rem 0 1rem;
            }

            ul#task-list { list-style: none; margin: 1.5rem 0 0; padding: 0; }
            li.task {
              display: flex;
              align-items: flex-start;
              gap: 0.8rem;
              padding: 0.9rem 0.2rem;
              border-bottom: 1px solid var(--line);
            }
            li.task.done .title { text-decoration: line-through; color: #9c9488; }
            li.task input[type=checkbox] {
              margin-top: 0.3rem;
              width: 18px; height: 18px;
              accent-color: var(--accent);
              cursor: pointer;
              flex-shrink: 0;
            }
            .task-body { flex: 1; min-width: 0; }
            .title { font-size: 1.05rem; }
            .meta {
              font-family: -apple-system, BlinkMacSystemFont, sans-serif;
              font-size: 0.75rem;
              color: #8a8378;
              margin-top: 0.25rem;
              display: flex;
              gap: 0.6rem;
              align-items: center;
              flex-wrap: wrap;
            }
            .badge {
              display: inline-block;
              padding: 0.1rem 0.5rem;
              border-radius: 20px;
              font-size: 0.68rem;
              font-weight: 600;
              text-transform: uppercase;
              letter-spacing: 0.03em;
            }
            .badge.p1 { background: #f4e2df; color: var(--p1); }
            .badge.p2 { background: #f3e9d9; color: var(--p2); }
            .badge.p3 { background: var(--accent-soft); color: var(--p3); }
            .delete-btn {
              background: none;
              border: none;
              color: #b5aca0;
              cursor: pointer;
              font-size: 1.1rem;
              padding: 0.2rem 0.4rem;
              line-height: 1;
              flex-shrink: 0;
            }
            .delete-btn:hover { color: var(--danger); }
            #empty {
              text-align: center;
              color: #9c9488;
              font-family: -apple-system, BlinkMacSystemFont, sans-serif;
              font-size: 0.9rem;
              padding: 3rem 0;
              display: none;
            }
    </style>
</head>
<body>

    <header>
        <h1>Todo</h1>
        <p>ASP.NET Core MVC + Web API</p>
    </header>

    <main>
        <form id="task-form">
            <input type="text" id="title" placeholder="Add a task…" required>
            <select id="priority">
                <option value="1">High</option>
                <option value="2" selected>Medium</option>
                <option value="3">Low</option>
            </select>
            <input type="date" id="dueDate">
            <button type="submit" style="grid-column: 1 / -1;">Add task</button>
        </form>

        <div id="status"></div>

        <ul id="task-list"></ul>
        <div id="empty">No tasks yet — add one above.</div>
    </main>

    <script>
            // Same-origin: the API is served by this same app, so a relative path works
            // with no CORS configuration needed.
            const API_BASE = '/api/tasks';

            const listEl = document.getElementById('task-list');
            const emptyEl = document.getElementById('empty');
            const statusEl = document.getElementById('status');
            const form = document.getElementById('task-form');

            function apiUrl(path = '') {
                return API_BASE + path;
            }

            function setStatus(msg, isError = false) {
                statusEl.textContent = msg;
                statusEl.style.color = isError ? '#a4443a' : '#8a5a3a';
                if (msg) setTimeout(() => { if (statusEl.textContent === msg) statusEl.textContent = ''; }, 4000);
            }

            function priorityLabel(p) {
                return { 1: 'High', 2: 'Medium', 3: 'Low' }[p] || 'Medium';
            }

            function formatDate(d) {
                if (!d) return null;
                const date = new Date(d);
                if (isNaN(date)) return null;
                return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
            }

            async function loadTasks() {
                setStatus('Loading…');
                try {
                    const res = await fetch(apiUrl());
                    if (!res.ok) throw new Error(`Server returned ${res.status}`);
                    const tasks = await res.json();
                    renderTasks(tasks);
                    setStatus('');
                } catch (err) {
                    setStatus('Could not reach API: ' + err.message, true);
                    listEl.innerHTML = '';
                    emptyEl.style.display = 'block';
                }
            }

            function renderTasks(tasks) {
                listEl.innerHTML = '';
                if (!tasks || tasks.length === 0) {
                    emptyEl.style.display = 'block';
                    return;
                }
                emptyEl.style.display = 'none';

                tasks
                    .slice()
                    .sort((a, b) => (a.isCompleted - b.isCompleted) || (a.priority - b.priority))
                    .forEach(task => {
                        const li = document.createElement('li');
                        li.className = 'task' + (task.isCompleted ? ' done' : '');

                        const checkbox = document.createElement('input');
                        checkbox.type = 'checkbox';
                        checkbox.checked = !!task.isCompleted;
                        checkbox.addEventListener('change', () => toggleComplete(task, checkbox.checked));

                        const body = document.createElement('div');
                        body.className = 'task-body';

                        const title = document.createElement('div');
                        title.className = 'title';
                        title.textContent = task.title;

                        const meta = document.createElement('div');
                        meta.className = 'meta';

                        const badge = document.createElement('span');
                        badge.className = 'badge p' + task.priority;
                        badge.textContent = priorityLabel(task.priority);
                        meta.appendChild(badge);

                        const due = formatDate(task.dueDate);
                        if (due) {
                            const dueSpan = document.createElement('span');
                            dueSpan.textContent = 'Due ' + due;
                            meta.appendChild(dueSpan);
                        }

                        body.appendChild(title);
                        body.appendChild(meta);

                        const delBtn = document.createElement('button');
                        delBtn.className = 'delete-btn';
                        delBtn.innerHTML = '&times;';
                        delBtn.title = 'Delete task';
                        delBtn.addEventListener('click', () => deleteTask(task.taskID));

                        li.appendChild(checkbox);
                        li.appendChild(body);
                        li.appendChild(delBtn);
                        listEl.appendChild(li);
                    });
            }

            async function createTask(payload) {
                const res = await fetch(apiUrl(), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error(`Create failed (${res.status})`);
            }

            async function toggleComplete(task, isCompleted) {
                const updated = { ...task, isCompleted };
                try {
                    const res = await fetch(apiUrl('/' + task.taskID), {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(updated)
                    });
                    if (!res.ok) throw new Error(`Update failed (${res.status})`);
                    loadTasks();
                } catch (err) {
                    setStatus(err.message, true);
                }
            }

            async function deleteTask(id) {
                try {
                    const res = await fetch(apiUrl('/' + id), { method: 'DELETE' });
                    if (!res.ok) throw new Error(`Delete failed (${res.status})`);
                    loadTasks();
                } catch (err) {
                    setStatus(err.message, true);
                }
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const titleInput = document.getElementById('title');
                const priorityInput = document.getElementById('priority');
                const dueDateInput = document.getElementById('dueDate');

                const payload = {
                    userID: 1,
                    listID: null,
                    title: titleInput.value.trim(),
                    description: null,
                    isCompleted: false,
                    priority: parseInt(priorityInput.value, 10),
                    dueDate: dueDateInput.value ? dueDateInput.value : null
                };

                if (!payload.title) return;

                try {
                    await createTask(payload);
                    titleInput.value = '';
                    dueDateInput.value = '';
                    priorityInput.value = '2';
                    setStatus('Task added');
                    loadTasks();
                } catch (err) {
                    setStatus(err.message, true);
                }
            });

            loadTasks();
    </script>

</body>
</html>
